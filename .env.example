# GEMINI_API_KEY: Required only if you enable server-side or client-side Gemini AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production domain URL (e.g. https://ias-autosalon.vercel.app).
APP_URL="https://your-domain.vercel.app"

# SESSION_SECRET: Secret key for signing admin session tokens (JWT/HMAC).
# Recommended for production deployment on Vercel or any hosting.
SESSION_SECRET="your-strong-random-session-secret-here"

